# ============================================
# ADIPHAS Environment Variables
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — only .env.template.

# --- Core (REQUIRED) ---
SECRET_KEY=SECRET_KEY_PLACEHOLDER_FOR_DEMO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (REQUIRED) ---
# Local dev uses SQLite by default. Set this for production (Neon Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/adiphas_db

# --- AI Keys (REQUIRED for full functionality) ---
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
TAVILY_API_KEY=your_tavily_key_here

# --- Frontend (set on Streamlit Cloud Secrets) ---
# Points the UI to the live backend API
BACKEND_URL=http://localhost:8000

# --- Twilio SMS Alerts (Optional) ---
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_FROM_NUMBER=your_twilio_number_here

# --- Email Alerts (Optional) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
